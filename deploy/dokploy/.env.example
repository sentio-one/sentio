# Paste into Dokploy -> this company's project -> Environment, then fill in the values. One gateway per company.
# Explained in README.md (same directory). Never commit real values; the secrets here belong only in Dokploy.

# --- Required: the deploy refuses to start without these ---
# Label only; names the image.
COMPANY_SLUG=acme
# The address users reach through the Cloudflare Tunnel. Also the OAuth redirect base (<PUBLIC_URL>/auth/callback).
PUBLIC_URL=https://acme.gw.example.com
# Google sign-in. Create a "Web application" OAuth client in Google Cloud Console, publish the consent screen to production.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated emails that are admins (the IdP must have verified them). Start with the operator's; add the customer's on handover.
ADMIN_EMAILS=you@yourcompany.example

# --- Optional ---
# IdP group whose members are also admins. Leave empty on Google (it has no groups claim).
ADMIN_GROUP=

# --- This company's model keys: set the ones in use, leave the rest empty ---
COMMANDCODE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
